# Repair Atlas embedding API
# Verified AWS API Gateway endpoint is in eu-north-1.
REPAIR_ATLAS_EMBEDDING_API_URL=https://q8099op9f9.execute-api.eu-north-1.amazonaws.com/embed

# Amazon Bedrock AgentCore
AGENTCORE_RUNTIME_ARN=

# Authentication (reserved for production identity provider integration)
AUTH_SECRET=

# Never place real credentials in this file.
