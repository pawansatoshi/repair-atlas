# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CockroachDB
DATABASE_URL=
DATABASE_SSL=true
DB_POOL_MAX=5
DEMO_ORG_ID=demo-org
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
