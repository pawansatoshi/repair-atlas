{
  "mcpServers": {
    "cockroachdb": {
      "type": "http",
      "url": "https://cockroachlabs.cloud/mcp",
      "headers": {
        "Authorization": "Bearer ${COCKROACH_MCP_API_KEY}"
      }
    }
  }
}

# Configure the exact authentication snippet generated by CockroachDB Cloud Console.
# Prefer read-only access for development; grant write consent only for explicitly approved operations.
# Never commit a real API key.